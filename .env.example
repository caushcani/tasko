# Copy to .env (repo root) for the Traefik deployment overlay:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.traefik.yml up -d --build
#
# Not used by the plain dev / prod compose stacks.

# Hostname Traefik routes to Tasko (dashboard + API share this one origin).
TASKO_DOMAIN=tasko.example.com

# Your Traefik cert resolver, as named in its static config.
TRAEFIK_CERTRESOLVER=letsencrypt

# The external docker network your Traefik instance is attached to.
TRAEFIK_NETWORK=traefik

# REQUIRED, Tasko has no built-in auth, so the reverse proxy must gate it.
# Generate a bcrypt entry and double every '$' so compose doesn't interpolate:
#   htpasswd -nbB admin 'your-password' | sed -e 's/\$/\$\$/g'
TASKO_BASICAUTH_USERS=

# Postgres password, the compose default is 'tasko'. Change it for anything
# real (and set the matching URL in tasko.docker.yaml).
POSTGRES_PASSWORD=tasko
