# Tasko core server — Python / FastAPI, built with uv.
# Build context is the repo root (see docker/docker-compose.yml).
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# The whole Python workspace — uv needs every member's pyproject to resolve.
COPY pyproject.toml uv.lock ./
COPY packages ./packages

# Install the v1 packages (tasko-core + tasko-middleware + tasko-redis) plus
# the async Postgres driver. --no-dev skips test/lint tooling.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra postgres

EXPOSE 8000

# --- dev: auto-reload on source changes; compose bind-mounts ../packages ---
FROM base AS dev
CMD ["uvicorn", "tasko_core.interfaces.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--reload-dir", "/app/packages"]

# --- prod: immutable image, runs the console script ---
FROM base AS prod
CMD ["tasko-core"]
