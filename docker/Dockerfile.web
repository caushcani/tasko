# Tasko dashboard — Next.js SSR server.
# Build context is the repo root (see docker/docker-compose.yml).
FROM node:20-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH"
# Pin pnpm to match web/pnpm-lock.yaml (lockfileVersion 9).
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /app

FROM base AS deps
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm/store \
    pnpm install --frozen-lockfile

# --- dev: Next dev server with HMR; compose bind-mounts ../web over /app
# and keeps this stage's node_modules via an anonymous volume ---
FROM deps AS dev
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["pnpm", "dev", "-H", "0.0.0.0", "-p", "3000"]

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time — a
# runtime `environment:` override in compose won't reach an already-built
# image. Pass the real one at build time:
#   docker compose ... build --build-arg NEXT_PUBLIC_TASKO_CORE_URL=https://tasko.example.com
ARG NEXT_PUBLIC_TASKO_CORE_URL=http://localhost:8000
ENV NEXT_PUBLIC_TASKO_CORE_URL=${NEXT_PUBLIC_TASKO_CORE_URL}
RUN pnpm build

FROM base AS run
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["pnpm", "start"]
